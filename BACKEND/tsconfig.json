{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "strict": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    "types": ["node", "bun"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src"]
}
