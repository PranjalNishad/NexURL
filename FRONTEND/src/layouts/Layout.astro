---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "NexURL — Short Links. Big Possibilities.",
  description = "Create short, powerful links with NexURL.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <meta name="theme-color" content="#08080d" />

    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-[var(--color-background)] text-[var(--color-foreground)]">
    <slot />
  </body>
</html>