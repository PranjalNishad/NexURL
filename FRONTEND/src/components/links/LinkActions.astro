---
interface Props {
  /** Extra classes for size/context (table vs card). */
  class?: string;
}

const { class: className = "" } = Astro.props;

const baseAction = [
  "inline-flex",
  "items-center",
  "gap-1.5",
  "rounded-lg",
  "px-2.5",
  "py-1.5",
  "text-xs",
  "font-medium",
  "text-[var(--color-text-muted)]",
  "transition-colors",
  "duration-200",
  "hover:bg-[var(--glass-background-hover)]",
  "hover:text-[var(--color-text-primary)]",
  "focus-visible:outline-none",
  "focus-visible:ring-2",
  "focus-visible:ring-[var(--color-border-active)]",
].join(" ");
---

<!-- Ghost-style row actions. No API wired yet — visual affordances only. -->
<div class:list={["flex items-center gap-1", className]}>
  <button type="button" class={baseAction} aria-label="Copy short URL" disabled title="Coming soon">
    <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="6" y="6" width="7" height="7" rx="1.5" />
      <path d="M10 6V4.5A1.5 1.5 0 0 0 8.5 3h-5A1.5 1.5 0 0 0 2 4.5v5A1.5 1.5 0 0 0 3.5 11H6" />
    </svg>
    Copy
  </button>

  <button type="button" class={baseAction} aria-label="View analytics" disabled title="Coming soon">
    <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 13V8M8 13V3M13 13v-3" />
    </svg>
    Analytics
  </button>

  <button type="button" class={baseAction} aria-label="More actions" disabled title="Coming soon">
    <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true">
      <circle cx="8" cy="3.5" r="1.4" />
      <circle cx="8" cy="8" r="1.4" />
      <circle cx="8" cy="12.5" r="1.4" />
    </svg>
    More
  </button>
</div>
