---
const links = [
  { href: "#features", label: "Features" },
  { href: "#analytics", label: "Analytics" },
  { href: "#how-it-works", label: "How it works" },
  { href: "/login", label: "Login" },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border-soft)] bg-[var(--color-background)]/70 backdrop-blur-xl">
  <nav
    class="container-page flex h-16 items-center justify-between gap-4"
    aria-label="Main"
  >
    <!-- Brand -->
    <a
      href="/"
      class="flex items-center gap-2 text-[var(--color-text-primary)]"
      aria-label="NexURL home"
    >
      <span
        class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--gradient-primary)] text-sm font-bold text-[#0b0b10]"
        aria-hidden="true"
      >
        N
      </span>
      <span class="text-lg font-semibold tracking-tight">
        <span class="font-light">Nex</span>
        <span class="gradient-text font-semibold">URL</span>
      </span>
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-lg",
              "px-3",
              "py-2",
              "text-sm",
              "font-medium",
              "text-[var(--color-text-muted)]",
              "transition-colors",
              "duration-200",
              "hover:text-[var(--color-text-primary)]",
              "focus-visible:outline-none",
              "focus-visible:ring-2",
              "focus-visible:ring-[var(--color-border-active)]",
              link.href === "/login" && "text-[var(--color-text-secondary)]",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a href="/signup" class="ml-2 inline-flex h-9 items-center rounded-lg bg-[var(--gradient-primary)] px-4 text-sm font-semibold text-[#0b0b10] shadow-[0_2px_20px_rgba(255,138,101,0.15)] transition-all duration-200 hover:brightness-105 hover:shadow-[0_6px_28px_rgba(255,138,101,0.28)] active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)]">
        Get Started
      </a>
    </div>

    <!-- Mobile menu toggle -->
    <button
      type="button"
      class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--glass-background-hover)] hover:text-[var(--color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)] md:hidden"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" data-nav-icon-open />
        <path d="M6 6l12 12M18 6L6 18" data-nav-icon-close class="hidden" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    data-nav-menu
    class="hidden border-t border-[var(--color-border-soft)] bg-[var(--color-background)]/95 px-4 pb-4 pt-2 backdrop-blur-xl md:hidden"
  >
    <div class="flex flex-col gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-3 py-2.5 text-sm font-medium text-[var(--color-text-secondary)] transition-colors hover:bg-[var(--glass-background-hover)] hover:text-[var(--color-text-primary)]"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/signup"
        class="mt-2 inline-flex h-10 items-center justify-center rounded-lg bg-[var(--gradient-primary)] text-sm font-semibold text-[#0b0b10]"
      >
        Get Started
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const menu = document.querySelector("[data-nav-menu]");
  const iconOpen = document.querySelector("[data-nav-icon-open]");
  const iconClose = document.querySelector("[data-nav-icon-close]");

  function closeMenu() {
    menu?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
  }

  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    if (isHidden) {
      menu?.classList.remove("hidden");
      toggle?.setAttribute("aria-expanded", "true");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    } else {
      closeMenu();
    }
  });

  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
</script>
