---
import Button from "@/components/common/Button.astro";
import GlassCard from "@/components/common/GlassCard.astro";
import Input from "@/components/common/Input.astro";
---

<GlassCard glow padding="lg" class="w-full max-w-md">
  <!-- Wordmark -->
  <a href="/" class="inline-flex items-center gap-2 text-[var(--color-text-primary)]" aria-label="NexURL home">
    <span
      class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--gradient-primary)] text-sm font-bold text-[#0b0b10]"
      aria-hidden="true"
    >
      N
    </span>
    <span class="text-lg font-semibold tracking-tight">
      <span class="font-light">Nex</span>
      <span class="gradient-text font-semibold">URL</span>
    </span>
  </a>

  <!-- Heading -->
  <h1 class="mt-6 m-0 text-2xl font-semibold tracking-tight text-[var(--color-text-primary)]">
    Create your account
  </h1>
  <p class="mt-2 m-0 text-sm leading-relaxed text-[var(--color-text-muted)]">
    Start creating and managing short links with NexURL.
  </p>

  <!-- Form -->
  <form id="signup-form" class="mt-8 flex flex-col gap-5" novalidate>
    <Input
      type="text"
      label="Name"
      name="name"
      id="signup-name"
      placeholder="Ada Lovelace"
      autocomplete="name"
      required
    />

    <Input
      type="email"
      label="Email"
      name="email"
      id="signup-email"
      placeholder="you@example.com"
      autocomplete="email"
      required
    />

    <Input
      type="password"
      label="Password"
      name="password"
      id="signup-password"
      placeholder="Create a password"
      autocomplete="new-password"
      required
    />

    <Input
      type="password"
      label="Confirm Password"
      name="confirmPassword"
      id="signup-confirm"
      placeholder="Repeat your password"
      autocomplete="new-password"
      required
    />

    <p
      id="signup-match-error"
      class="m-0 hidden text-sm text-[var(--color-danger)]"
      role="alert"
    >
      Passwords do not match.
    </p>

    <Button type="submit" fullWidth size="lg" class="mt-1">
      Create Account
    </Button>

    <p
      id="signup-status"
      class="m-0 hidden text-center text-sm text-[var(--color-text-muted)]"
      role="status"
    >
      Account creation isn&rsquo;t connected to a backend yet — nothing was submitted.
    </p>
  </form>

  <!-- Footer -->
  <div class="mt-8 border-t border-[var(--color-border-soft)] pt-6 text-center">
    <p class="m-0 text-sm text-[var(--color-text-muted)]">
      Already have an account?&nbsp;
      <a
        href="/login"
        class="font-medium text-[var(--color-text-primary)] transition-colors duration-200 hover:text-[var(--color-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-active)]"
      >
        Sign in
      </a>
    </p>
  </div>
</GlassCard>

<script>
  const form = document.getElementById("signup-form");
  const status = document.getElementById("signup-status");
  const matchError = document.getElementById("signup-match-error");
  const password = document.getElementById("signup-password") as HTMLInputElement | null;
  const confirm = document.getElementById("signup-confirm") as HTMLInputElement | null;

  form?.addEventListener("submit", (event) => {
    // Client-side check before anything else.
    const mismatch = Boolean(password && confirm && password.value !== confirm.value);
    if (mismatch) {
      event.preventDefault();
      matchError?.classList.remove("hidden");
      confirm?.focus();
      return;
    }

    // No backend API contract yet — prevent navigation and inform the user.
    event.preventDefault();
    matchError?.classList.add("hidden");
    if (status) {
      status.classList.remove("hidden");
      window.setTimeout(() => status.classList.add("hidden"), 4000);
    }
  });

  // Clear the mismatch error as the user types.
  confirm?.addEventListener("input", () => {
    matchError?.classList.add("hidden");
  });
</script>
