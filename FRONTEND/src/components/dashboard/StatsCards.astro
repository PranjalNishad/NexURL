---
interface Stat {
  label: string;
  value: string;
  icon: string;
  accent: string;
}

interface Props {
  /** Neutral values until the backend contract is connected. */
  totalLinks?: number | null;
  totalClicks?: number | null;
  activeLinks?: number | null;
  recentClicks?: number | null;
}

const { totalLinks = null, totalClicks = null, activeLinks = null, recentClicks = null } =
  Astro.props;

const stats: Stat[] = [
  {
    label: "Total Links",
    value: totalLinks === null ? "--" : String(totalLinks),
    accent: "text-[var(--color-primary)]",
    icon: '<path d="M9.5 14.5 14.5 9.5" /><path d="M8 12.5 5.5 15a3 3 0 0 0 4.2 4.2L12 16.7" /><path d="M16 11.5l2.5-2.5a3 3 0 0 0-4.2-4.2L12 7.3" />',
  },
  {
    label: "Total Clicks",
    value: totalClicks === null ? "--" : String(totalClicks),
    accent: "text-[var(--color-secondary)]",
    icon: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />',
  },
  {
    label: "Active Links",
    value: activeLinks === null ? "--" : String(activeLinks),
    accent: "text-[var(--color-success)]",
    icon: '<circle cx="12" cy="12" r="8" /><path d="m8.5 12 2.5 2.5 4.5-5" />',
  },
  {
    label: "Recent Clicks",
    value: recentClicks === null ? "--" : String(recentClicks),
    accent: "text-[var(--color-accent)]",
    icon: '<circle cx="12" cy="12" r="8" /><path d="M12 7v5l3.5 2" />',
  },
];
---

<ul class="grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 xl:grid-cols-4">
  {
    stats.map((stat) => (
      <li class="p-0">
        <div class="rounded-xl border border-[var(--color-border-soft)] bg-[var(--color-surface)] p-5">
          <div class="flex items-center justify-between gap-3">
            <span class="text-xs font-medium uppercase tracking-wide text-[var(--color-text-muted)]">
              {stat.label}
            </span>
            <span
              class:list={[
                "flex h-8 w-8 shrink-0 items-center justify-center rounded-lg",
                "bg-[var(--gradient-primary-soft)]",
                stat.accent,
              ]}
            >
              <svg
                viewBox="0 0 24 24"
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={stat.icon}
              />
            </span>
          </div>
          <p class="mt-3 m-0 font-mono text-2xl font-semibold tracking-tight text-[var(--color-text-primary)]">
            {stat.value}
          </p>
        </div>
      </li>
    ))
  }
</ul>
